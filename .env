# Backend API
VITE_API_BASE_URL=http://localhost:8000

# Map config
VITE_MAP_IMAGE_URL=/maps/BetaMap.png
# These two are read at runtime from the image's natural size, so no need to hardcode width/height.
VITE_MAP_Z_INCREASES_DOWN=1   # 1 = MC +Z goes down on the image; set 0 to invert if needed
VITE_RECENT_SECONDS=60

# Demo: mod API (HTTP polling)
VITE_MOD_POSITIONS_URL=/mc/positions/snapshot
VITE_MOD_POLL_MS=4000        # demo tick; feel free to tweak


VITE_POSITIONS_DEMO=0
